# ==============================================================================
# GeoGuard Machine Learning Service — Environment Configuration
# ==============================================================================

# --- Area of Interest (AOI) Configuration ---
# Provide the confirmed highway corridor name and bounding box coordinates.
# Format for HIGHWAY_AOI_BBOX: min_longitude, min_latitude, max_longitude, max_latitude (in WGS84 decimal degrees).
# Example for a 10 km corridor: HIGHWAY_AOI_BBOX=78.50,30.30,78.60,30.40
HIGHWAY_CORRIDOR_NAME=UNCONFIGURED_HIGHWAY_CORRIDOR
HIGHWAY_AOI_BBOX=

# --- Copernicus Data Space Ecosystem (CDSE) Credentials ---
# Register for free credentials at https://dataspace.copernicus.eu/
# If credentials are not provided, the service safely enters SIMULATED test mode.
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# --- ML Model & Threshold Settings ---
# Decision threshold for declaring a patch positive for landslides:
# Default tuned to 0.40 on validation data to achieve 81.8% landslide recall.
DECISION_THRESHOLD=0.40

# Number of positive pixels in a 128x128 patch to declare it a landslide in training:
LANDSLIDE_PIXEL_THRESHOLD=100

# Maximum tolerable cloud cover percentage for satellite acquisitions (0-100):
MAX_CLOUD_COVER_PERCENT=30.0

# --- Scheduler & Service Settings ---
# Interval in minutes for the background scheduler to check for new acquisitions:
# (Note: Satellite revisit interval is ~5 days; scheduler polling checks every 15 mins).
POLLING_INTERVAL_MINUTES=15

# Path to database for storing prediction history:
DATABASE_PATH=data/geoguard_predictions.db
